{
  "name": "dsh-tokenledger-pro",
  "version": "0.1.0-pro.0",
  "description": "Independent TokenLedger fork for DeepSeek Harness: token usage, balances and provider adaptations",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SherryXXX8043/dsh-TokenLedger-pro.git"
  },
  "homepage": "https://github.com/SherryXXX8043/dsh-TokenLedger-pro#readme",
  "bugs": {
    "url": "https://github.com/SherryXXX8043/dsh-TokenLedger-pro/issues"
  },
  "exports": {
    ".": "./src/index.js",
    "./adapters/detect": "./src/adapters/detect.js",
    "./balance": "./src/balance.js",
    "./declarative": "./src/declarative.js",
    "./client": "./src/client.js",
    "./discovery": "./src/discovery.js",
    "./fingerprints": "./src/fingerprints.js",
    "./http": "./src/http.js",
    "./package.json": "./package.json",
    "./plugin": "./src/plugin.js",
    "./pricing": "./src/pricing.js",
    "./projects": "./src/projects.js",
    "./quota": "./src/quota.js",
    "./relay-sites": "./src/relay-sites.js",
    "./report": "./src/report.js",
    "./store": "./src/store.js",
    "./subscriptions": "./src/subscriptions.js",
    "./usage": "./src/usage.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "locale",
    "icon.svg",
    "blue.plugin.json",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "docs/PRO-MIGRATION.md",
    "docs/DESKTOP-SUPPORT.md",
    "docs/SETTINGS.md",
    "docs/BLUE-MIGRATION.md",
    "docs/images"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "fixture:blue": "node test/blue-packed-fixture.mjs --install"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "billing",
    "dsh-bundle",
    "cordis-plugin",
    "relay-attribution"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "blue": {
    "manifest": "./blue.plugin.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
